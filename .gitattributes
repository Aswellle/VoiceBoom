# Normalize line endings: repository stores LF, checkouts use LF.
# GitHub Actions workflow parsing and Rust tooling both expect LF.
* text=auto eol=lf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.onnx binary
*.msi binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.zip binary
*.tar.gz binary
*.bz2 binary

# Windows-only scripts keep CRLF for compatibility with legacy tooling.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
