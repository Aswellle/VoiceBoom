{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VoiceBoom",
  "version": "0.3.0",
  "identifier": "com.voiceboom.app",

  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "VoiceBoom AI",
        "label": "floating",
        "width": 600,
        "height": 140,
        "minWidth": 320,
        "minHeight": 100,
        "maxWidth": 900,
        "maxHeight": 500,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "center": true,
        "x": 0,
        "y": 50,
        "visible": true,
        "fullscreen": false,
        "resizable": true,
        "skipTaskbar": true
      },
      {
        "title": "VoiceBoom 设置",
        "label": "settings",
        "width": 860,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": true,
        "resizable": true,
        "center": true,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss: https:;"
    }
  },

  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Private, low-latency AI voice input for your desktop.",

    "resources": [
      "resources/runtime/.gitkeep"
    ],


    "windows": {
      "nsis": {
        "compression": "lzma",
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },

    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    },

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }


}
