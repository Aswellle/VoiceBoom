{
  "productName": "VoiceBoom",
  "version": "0.1.0",
  "identifier": "com.voiceboom.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VoiceBoom AI",
        "label": "floating",
        "width": 600,
        "height": 120,
        "minWidth": 300,
        "minHeight": 90,
        "maxWidth": 900,
        "maxHeight": 600,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "center": true,
        "x": 0,
        "y": 50,
        "visible": true,
        "fullscreen": false,
        "resizable": true,
        "skipTaskbar": true
      },
      {
        "title": "VoiceBoom Settings",
        "label": "settings",
        "width": 720,
        "height": 560,
        "minWidth": 600,
        "minHeight": 480,
        "decorations": true,
        "alwaysOnTop": false,
        "transparent": false,
        "center": true,
        "visible": false,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
